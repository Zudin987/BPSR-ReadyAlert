<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BPSR-ReadyAlert</AssemblyName>
    <RootNamespace>BPSR.ReadyAlert</RootNamespace>
    <Version>1.1.0-rc.5</Version>
    <Authors>Zudin987</Authors>
    <Description>Portable matchmaking, Ready Check, and optional chat overlay companion for Blue Protocol: Star Resonance.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- RC5 UI overhaul is compiled from side-by-side files while the RC4 UI
         source remains on the feature branch for easy review/rollback. -->
    <Compile Remove="ChatOverlayForm.cs" />
    <Compile Remove="ChatOverlayDialogs.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\LetsDoThis.wav" LogicalName="BPSR.ReadyAlert.Assets.LetsDoThis.wav" />
    <EmbeddedResource Include="Assets\App.ico" LogicalName="BPSR.ReadyAlert.Assets.App.ico" />
  </ItemGroup>

  <Target Name="RequireBuildInputs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('Assets\App.ico')" Text="Missing Assets/App.ico." />
    <Error Condition="!Exists('Assets\LetsDoThis.wav')" Text="Missing Assets/LetsDoThis.wav. Run scripts/prepare-build-assets.ps1 or use the GitHub Actions build." />
  </Target>
</Project>